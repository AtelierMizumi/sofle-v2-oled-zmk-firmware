#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define SYM 1
#define NAV 2
#define ADJUST 3
#define GAME 4
#define FIGHT 5

&left_encoder { resolution = <1>; };
&right_encoder { resolution = <1>; };

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <SYM NAV>;
            then-layer = <ADJUST>;
        };
    };

    behaviors {
        td_slash: tap_dance_slash {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp FSLH>, <&kp BSLH>;
            label = "tap_dance_slash";
        };

        td_esc: tap_dance_escape {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;
            tapping-term-ms = <200>;
            label = "tap_dance_escape";
        };

        mt_space: mod_tap_space {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_SPACE";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        mt_ent: mod_tap_enter {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_ENTER";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
&td_esc    &kp N1  &kp N2     &kp N3     &kp N4    &kp N5                                                     &kp N6  &kp N7              &kp N8     &kp N9    &kp N0     &kp DEL
&kp TAB    &kp Q   &kp W      &kp E      &kp R     &kp T                                                      &kp Y   &kp U               &kp I      &kp O     &kp P      &kp BSLH
&kp LALT   &kp A   &kp S      &kp D      &kp F     &kp G                                                      &kp H   &kp J               &kp K      &kp L     &kp SEMI   &kp SQT
&kp LSHFT  &kp Z   &kp X      &kp C      &kp V     &kp B   &kp C_MUTE               &kp C_PP                  &kp N   &kp M               &kp COMMA  &kp DOT   &td_slash  &to GAME
                   &kp MINUS  &kp EQUAL  &kp LGUI  &mo SYM  &mt_space LCTRL SPACE    &kp BACKSPACE             &mo NAV  &mt_ent RALT ENTER  &kp LBKT   &kp RBKT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };

        sym_layer {
            label = "SYM";
            bindings = <
&kp F1     &kp F2     &kp F3     &kp F4    &kp F5    &kp F6                       &kp F7     &kp F8    &kp F9    &kp F10   &kp F11    &kp F12
&kp TILDE  &kp EXCL   &kp AT     &kp HASH  &kp DLLR  &kp PRCNT                    &kp CARET  &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR   &kp PIPE
&kp GRAVE  &kp N1     &kp N2     &kp N3    &kp N4    &kp N5                       &kp N6     &kp N7    &kp N8    &kp N9    &kp N0     &kp UNDER
&trans     &kp EQUAL  &kp MINUS  &kp PLUS  &kp LBRC  &kp RBRC   &trans    &trans  &kp LBKT   &kp RBKT  &kp LT    &kp GT    &kp QMARK  &trans
                      &trans     &trans    &trans    &trans     &trans    &trans  &trans     &trans    &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };

        nav_layer {
            label = "NAV";
            bindings = <
&none       &none         &none         &none         &none         &none                            &none      &none     &none     &none      &none    &none
&none       &kp INS       &kp PSCRN     &kp K_CMENU   &none         &none                           &kp PG_UP  &kp HOME  &kp UP    &kp END    &none    &none
&none       &kp LCTRL     &kp LALT      &kp LGUI      &kp LSHFT     &none                           &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL  &kp BSPC
&trans      &kp LC(Z)     &kp LC(X)     &kp LC(C)     &kp LC(V)     &none         &trans    &trans  &none      &none     &none     &none      &none    &trans
                          &trans        &trans        &trans        &trans        &trans    &trans  &trans     &trans    &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };

        adjust_layer {
            label = "ADJUST";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                               &none   &none  &none  &none  &none  &sys_reset
&kp GRAVE          &kp TILDE        &kp LBKT        &kp RBKT        &kp LBRC        &kp RBRC                              &kp BSLH &kp PIPE &kp LT &kp GT &kp DQT &kp SQT
&kp SEMI           &kp COLON        &kp SQT         &kp DQT         &kp BSLH        &kp PIPE                              &kp TAB  &kp ESC  &kp DEL &kp BSPC &none &none
&kp LC(Z)          &kp LC(X)        &kp LC(C)       &kp LC(V)       &kp LC(S)       &kp LC(F)        &none        &none  &none   &none   &none  &none  &none  &none
                                    &none            &none            &none            &trans           &none              &none  &trans  &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };

        game_layer {
            label = "GAME";
            bindings = <
&kp ESC           &kp N1  &kp N2     &kp N3     &kp N4    &kp N5                                 &kp N6  &kp N7     &kp N8     &kp N9    &kp N0    &kp DEL
&kp TAB           &kp Q   &kp W      &kp E      &kp R     &kp T                                  &kp Y   &kp U      &kp I      &kp O     &kp P     &kp BSLH
&kp LEFT_CONTROL  &kp A   &kp S      &kp D      &kp F     &kp G                                  &kp H   &kp J      &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT         &kp Z   &kp X      &kp C      &kp V     &kp B     &kp C_MUTE    &kp C_PP       &kp N   &kp M      &kp COMMA  &kp DOT   &kp FSLH  &to FIGHT
                          &kp MINUS  &kp EQUAL  &kp LGUI  &kp LALT  &kp SPACE     &kp BACKSPACE  &none   &kp ENTER  &kp LBKT   &kp RBKT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };

        fight_layer {
            label = "FIGHT";
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3  &kp N4    &kp N5                               &kp N6    &kp N7          &kp N8     &kp N9     &kp N0     &kp DEL
&kp TAB    &none   &none   &kp U   &kp I     &kp O                                &none     &none           &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp BSLH
&kp LALT   &none   &kp W   &kp J   &kp K     &kp L                                &none     &kp UP          &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp SQT
&kp LSHFT  &kp A   &kp S   &kp D   &none     &none   &kp C_MUTE    &kp C_PP       &kp LEFT  &kp DOWN_ARROW  &kp RIGHT  &none      &none      &to BASE
                   &none   &none   &kp LGUI  &trans  &kp SPACE     &kp BACKSPACE  &none     &none           &none      &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };
    };
};
